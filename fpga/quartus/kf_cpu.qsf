# Quartus Prime project for the Kalman filter coprocessor (rtl/kf_cpu.v).
# Compile:  quartus_sh --flow compile kf_cpu     (or ./build.sh / build.ps1)
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C7
set_global_assignment -name TOP_LEVEL_ENTITY kf_cpu
set_global_assignment -name VERILOG_FILE ../rtl/kf_cpu.v
set_global_assignment -name VERILOG_FILE ../rtl/kf_rom.v
set_global_assignment -name SEARCH_PATH ../rtl
set_global_assignment -name SDC_FILE kf_cpu.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
# The host port is wider than a board connector: until a UART/SPI bridge is added in front
# of it, route it as virtual pins (timing and area study).
set_instance_assignment -name VIRTUAL_PIN ON -to host_*
set_instance_assignment -name VIRTUAL_PIN ON -to cmd
set_instance_assignment -name VIRTUAL_PIN ON -to start
set_instance_assignment -name VIRTUAL_PIN ON -to busy
set_instance_assignment -name VIRTUAL_PIN ON -to done
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 SP0.02std Lite Edition"
set_global_assignment -name EDA_SIMULATION_TOOL "QuestaSim (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation